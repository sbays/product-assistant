{
  "name": "product-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "try-agent": "tsx --conditions=react-server --env-file=.env.local scripts/try-agent.mts",
    "try-get-products": "tsx --conditions=react-server --env-file=.env.local scripts/try-get-products.mts",
    "try-injection": "tsx --conditions=react-server --env-file=.env.local scripts/try-injection.mts",
    "try-search": "tsx --conditions=react-server --env-file=.env.local scripts/try-search.mts",
    "try-structured": "tsx --conditions=react-server --env-file=.env.local scripts/try-structured.mts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.149",
    "ai": "^7.0.145",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-loading-skeleton": "^3.5.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "braces@<=3.0.3": "<0.0.0"
    }
  }
}
